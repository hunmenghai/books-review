<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Books Review</title>
    <link rel="stylesheet" href="/styles/main.css">
</head>
<body>
    <div class="page-container">

  <header class="page-header">
    <h1>Books Review</h1>
    <p>Notes and reviews from books I've read.</p>
  </header>

  <section class="controls">

    <form action="/" method="GET" class="sort-form">
      <label for="sort">Sort by</label>

      <select name="sort" id="sort">
        <option value="default" <%= sort === "default" ? "selected" : "" %>>
          Default
        </option>
        <option value="rating" <%= sort === "rating" ? "selected" : "" %>>
          Rating
        </option>
        <option value="recent" <%= sort === "recent" ? "selected" : "" %>>
          Newest
        </option>
        <option value="title" <%= sort === "title" ? "selected" : "" %>>
          Title
        </option>
      </select>

      <button type="submit">Sort</button>
    </form>

  </section>

  <section class="add-section">

    <h2>Add a Book</h2>

    <form action="/add-book" method="POST" class="add-book-form">

      <div class="form-grid">
        <input type="text" name="isbn" placeholder="ISBN" required>

        <input type="text" name="title" placeholder="Title (fallback)">

        <input type="text" name="author" placeholder="Author" required>

        <input
          type="number"
          name="publication_year"
          placeholder="Publication Year"
        >

        <input
          type="number"
          name="rating"
          min="1"
          max="5"
          placeholder="Rating"
          required
        >

        <input type="date" name="finished_at">
      </div>

      <textarea
        name="note"
        placeholder="Write your note..."
      ></textarea>

      <button type="submit" class="primary-btn">
        Add Book
      </button>

    </form>

  </section>

  <section class="books">

    <% books.forEach(book => { %>

      <article class="book-card">

        <div class="cover-wrapper">
          <img
            src="https://covers.openlibrary.org/b/isbn/<%= book.isbn %>-L.jpg"
            alt="<%= book.title %> cover"
            class="book-cover"
          >
        </div>

        <div class="book-content">

          <div class="book-heading">
            <div>
              <h2><%= book.title %></h2>
              <p class="author">by <%= book.author %></p>
            </div>

            <div class="rating">
              ★ <%= book.rating %>/5
            </div>
          </div>

          <div class="book-meta">
            <span>
              Published <%= book.publication_year || "Unknown" %>
            </span>
            <span>ISBN <%= book.isbn %></span>
            
          </div>

          <p class="book-note">
            <%= book.note %>
          </p>

          <p class="finished-date">
            Finished:
            <%= book.finished_at
              ? new Date(book.finished_at).toLocaleDateString("en-GB")
              : "Not specified"
            %>
          </p>

          <div class="book-actions">

            <form action="/edit" method="POST" class="edit-form">
              <input type="hidden" name="id" value="<%= book.id %>">

              <textarea name="note"><%= book.note %></textarea>

              <input
                type="number"
                name="rating"
                min="1"
                max="5"
                value="<%= book.rating %>"
              >

              <button type="submit" class="secondary-btn">
                Update
              </button>
            </form>

            <form action="/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this book?')">
              <input type="hidden" name="id" value="<%= book.id %>">

              <button type="submit" class="delete-btn">
                Delete
              </button>
            </form>

          </div>

        </div>

      </article>

    <% }) %>

  </section>

</div>
</body>
</html>